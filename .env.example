# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority

# Cloudinary Configuration (for product images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT Secret (for authentication - future use)
JWT_SECRET=your-random-secret-key-here-change-in-production

# Kashier Payment Gateway Configuration
# Test Mode Credentials (get from https://merchant.kashier.io/)
KASHIER_MERCHANT_ID=MID-12345-678
KASHIER_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KASHIER_SECRET_KEY=your-very-long-secret-key-here
KASHIER_MODE=test

# Application URL (for Kashier redirects)
APP_URL=http://localhost:3000

# Server Configuration
PORT=5000
NODE_ENV=development

# Notes:
# 1. For Kashier Test Mode: use Test credentials from Kashier Dashboard
# 2. For Kashier Live Mode: change KASHIER_MODE=live and use Live credentials
# 3. Never commit this file with real credentials to git!
# 4. Copy this file to .env and fill in your actual values
